# --- Telegram (your phone app, both directions) -------------------------
# 1. In Telegram, message @BotFather -> /newbot -> paste the token here.
# 2. Message your new bot once, then run: python -m costwatch chat-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Gemini (reads receipt photos and coupon book pages) ----------------
# Free key, no card: https://aistudio.google.com/apikey
# ~40 images/month sits far inside the free tier.
GEMINI_API_KEY=
# Override only if Google renames the model.
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Behaviour ----------------------------------------------------------
# Costco's price adjustment window, in days. Their policy is 30.
ADJUSTMENT_WINDOW_DAYS=30
# Warn this many days before an item ages out of the window.
ALERT_LEAD_DAYS=7
# Where to pull the monthly Member-Only Savings book page images from.
COUPON_BOOK_SOURCE=https://costco97.com/costco-coupon-book/
